{
  "name": "ankino-youth-hub",
  "version": "1.0.0",
  "description": "Kenyan youth tech hub SPA — Founded by ANKINO DEVELOPERS · Powered by Safaricom",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "canvas-sketch sketch.js --open",
    "lint": "eslint src/ vite.config.js vitest.config.js",
    "lint:fix": "eslint src/ vite.config.js vitest.config.js --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:ci": "vitest run --coverage --reporter=verbose",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit --allowJs --checkJs --strict src/**/*.js 2>&1 || true",
    "swa:start": "swa start http://localhost:3000 --run \"npm run dev\" --api-location api",
    "swa:deploy": "npm run build && swa deploy ./dist --api-location ./api --env production --deployment-token $AZURE_STATIC_WEB_APPS_API_TOKEN"
  },
  "keywords": [
    "kenya",
    "youth",
    "tech",
    "safaricom",
    "mpesa",
    "daraja",
    "nairobi",
    "hackathon"
  ],
  "author": "ANKINO DEVELOPERS",
  "license": "MIT",
  "devDependencies": {
    "@azure/static-web-apps-cli": "^2.0.9",
    "@eslint/js": "^9.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "@vitest/ui": "^3.0.0",
    "canvas-sketch": "^0.7.7",
    "canvas-sketch-cli": "^1.15.0",
    "eslint": "^9.0.0",
    "gsap": "^3.15.0",
    "jsdom": "^26.0.0",
    "vite": "^8.0.10",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "firebase": "^12.13.0"
  }
}
