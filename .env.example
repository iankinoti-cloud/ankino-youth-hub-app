# ═══════════════════════════════════════════════════════════
#  ANKINO YOUTH HUB — Environment Variables Template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to Git — it's in .gitignore.
#
#  ⚠️  SECRETS POLICY
#  - Server-side keys (ANTHROPIC_API_KEY, DARAJA_*, GEMINI_API_KEY) live in
#    Azure SWA → Configuration → Application Settings. They are NOT bundled
#    into the frontend. The browser only ever talks to /api/* on the SWA.
#  - Anything prefixed VITE_ IS exposed to the browser — never put a secret
#    behind a VITE_ prefix.
#  - If a key ever leaks (pasted in chat, committed, etc.) — rotate it
#    immediately. See scripts/ROTATE_SECRETS.md.
# ═══════════════════════════════════════════════════════════


# ── App Config ─────────────────────────────────────────────
NODE_ENV=development
VITE_APP_NAME=Ankino Youth Hub
VITE_APP_VERSION=1.0.0
VITE_API_BASE=/api

# ── Safaricom Daraja API (Sandbox) ─────────────────────────
# Get these from developer.safaricom.co.ke (free account)
DARAJA_CONSUMER_KEY=your_sandbox_consumer_key
DARAJA_CONSUMER_SECRET=your_sandbox_consumer_secret
DARAJA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
DARAJA_SHORTCODE=174379
DARAJA_ENV=sandbox
# In production: change DARAJA_ENV=production + use live credentials

# ── Daraja Callback URLs ────────────────────────────────────
# Azure Static Web Apps URL (set after `az staticwebapp create`)
# Format: https://<random-name>.azurestaticapps.net
DARAJA_CALLBACK_URL=https://YOUR_SWA_URL.azurestaticapps.net/api/mpesa/callback
DARAJA_B2C_RESULT_URL=https://YOUR_SWA_URL.azurestaticapps.net/api/mpesa/b2c/result
DARAJA_B2C_TIMEOUT_URL=https://YOUR_SWA_URL.azurestaticapps.net/api/mpesa/b2c/timeout

# ── Africa's Talking (SMS/USSD) ────────────────────────────
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=sandbox

# ── AI APIs (server-side only — set in Azure SWA App Settings) ─
# Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini — https://aistudio.google.com
GEMINI_API_KEY=AIza...

# ── Azure Resources ─────────────────────────────────────────
# Set after running: scripts/azure-setup.sh
AZURE_SUBSCRIPTION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_RESOURCE_GROUP=ankino-youth-hub-rg
AZURE_LOCATION=southafricanorth
AZURE_SWA_NAME=ankino-youth-hub
AZURE_SWA_URL=https://YOUR_SWA_URL.azurestaticapps.net
AZURE_APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
AZURE_APPINSIGHTS_NAME=ankino-youth-hub-insights

# ── GitHub (for MCP server + CI/CD automation) ────────────
GITHUB_TOKEN=ghp_...

# ── Analytics ──────────────────────────────────────────────
# Application Insights connection string (VITE_ prefix = safe to expose)
VITE_APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# ── Firebase (Firestore) ────────────────────────────────────
# These are PUBLIC client-side config values — safe to expose in the browser.
# Get them from: console.firebase.google.com → Project Settings → Your apps
# Project: ankino-youth-hub (kinotiian12@gmail.com)
VITE_FIREBASE_API_KEY=AIzaSyDMKUcEUD__yND4oVGG5IRp0bto7d7C1Do
VITE_FIREBASE_AUTH_DOMAIN=ankino-youth-hub.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ankino-youth-hub
VITE_FIREBASE_STORAGE_BUCKET=ankino-youth-hub.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1059334451008
VITE_FIREBASE_APP_ID=1:1059334451008:web:4022aaa62a44a0df8f54a5
VITE_FIREBASE_MEASUREMENT_ID=G-9NKHSE1CDY
